# Audit Workbench environment variables.
# Copy to .env (local) and set the same values in Vercel → Project → Settings → Environment Variables.

# --- Supabase (Auth + profiles) ---
# Supabase dashboard → Project Settings → API (or Connect).
# Safe for the browser: row-level security protects the profiles table.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx

# --- Gemini (classifies journal lines the rules can't place) ---
# Google AI Studio → Get API key. Server-only: never prefix with NEXT_PUBLIC_.
# Set a spending limit / quota on the Google Cloud project before sharing the link.
GEMINI_API_KEY=
# Optional; comma-separated models tried in order (busy or retired ones are skipped).
GEMINI_MODEL=gemini-3.8-flash,gemini-3.5-flash-lite
